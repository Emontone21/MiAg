# Copiá este archivo a .env.local y completá los valores.
# En Vercel se cargan en Settings > Environment Variables.

# --- Supabase (fase 1) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública ("publishable" o "anon"). Es la única que llega al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio ("secret" o "service_role"). Solo servidor. Nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cerebro del Agente (fase 3) ---
GEMINI_API_KEY=
GEMINI_MODEL_CHAT=
GEMINI_MODEL_FONDO=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Opcional: modelo local detrás de un túnel con autenticación.
OLLAMA_BASE_URL=
OLLAMA_AUTH_TOKEN=
OLLAMA_MODEL=

# --- Voz (fase 5) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Llamadas programadas (fase 6) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
CRON_SECRET=
